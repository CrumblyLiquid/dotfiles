[global]
monitor = 0
follow = none

# = Shown notifications =
notification_limit = 20
show_age_threshold = 30

# = History =
history_length = 30

# = Geometry =
width = 300
height = (64, 256)
origin = top-right
offset = (5, 5)

### Text ###
font = monospace
ellipsize = end

# = Icons =
icon_position = left
icon_theme = "Papirus-Dark, breeze-dark"
enable_recursive_icon_lookup = true

# = Misc =
dmenu = /usr/bin/env tofi --prompt-text "dunst: "
browser = /usr/bin/env xdg-open

# = Mouse actions =
mouse_left_click = close_current
mouse_middle_click = open_url, context
mouse_right_click = close_all

padding = 10
horizontal_padding = 10
frame_width = 1
gap_size = 4
corner_radius = 4

background = "#26233a"
foreground = "#e0def4"

[urgency_low]
background = "#26273d"
highlight = "#31748f"
frame_color = "#31748f"
default_icon = "dialog-information"
format = "<b><span foreground='#31748f'>%s</span> - %a</b>\n%b"

[urgency_normal]
background = "#362e3c"
highlight = "#f6c177"
frame_color = "#f6c177"
default_icon = "dialog-warning"
format = "<b><span foreground='#f6c177'>%s</span> - %a</b>\n%b"

[urgency_critical]
background = "#35263d"
highlight = "#eb6f92"
frame_color = "#eb6f92"
default_icon = "dialog-error"
format = "<b><span foreground='#eb6f92'>%s</span> - %a</b>\n%b"
