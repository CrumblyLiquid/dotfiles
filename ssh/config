    HostName ssh.github.com
    Port 443
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

Host gitlab.fit.cvut.cz
    IdentityFile ~/.ssh/gitlab_fit
    IdentitiesOnly yes

Host gitlab.freedesktop.org
    IdentityFile ~/.ssh/id_fdorg_ed25519
    IdentitiesOnly yes

Host gitlab.nic.cz
    IdentityFile ~/.ssh/cznic_ed25519
    IdentitiesOnly yes

Host crumblyliquid.com
    IdentityFile ~/.ssh/id_server_ed25519
    IdentitiesOnly yes

